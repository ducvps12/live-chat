# ───────── NemarkChat Production Configuration ─────────
# Single-port deployment: Next.js + API + Socket.IO all on one port

# ───────── Server ─────────
PORT=4001
NODE_ENV=production
BASE_URL=https://nemarkchat.com
FRONTEND_URL=https://nemarkchat.com

# ───────── Database ─────────
MONGO_URI=mongodb://127.0.0.1:27017/nemark_prod

# ───────── JWT ─────────
JWT_SECRET=CHANGE_ME_TO_STRONG_RANDOM_KEY
JWT_EXPIRES_IN=7d
# Dedicated 32+ character key for AES-GCM encrypted admin settings.
# Keep it in the deployment secret store; never commit the real value.
SETTINGS_ENCRYPTION_KEY=

# ───────── Frontend → Backend URL ─────────
# Same port! Just set to your domain or server IP with the same port:
# Example: https://api.nemarkchat.com/api
NEXT_PUBLIC_API_URL=https://api.nemarkchat.com/api

# Public landing-page chat widget (the widget ID is a public embed identifier, not a credential)
NEXT_PUBLIC_LANDING_WIDGET_ID=cmr6lsujd00071sv6xl02s7dr
NEXT_PUBLIC_LANDING_WIDGET_API_BASE=https://api.nemarkchat.com

# ───────── OAuth Callback URLs ─────────
# Facebook credentials should normally be entered in Admin Panel > Settings > Facebook.
# These server-only variables are fallbacks for first boot and disaster recovery.
FB_APP_ID=
FB_APP_SECRET=
FB_VERIFY_TOKEN=
FB_REDIRECT_URI=https://nemarkchat.com/api/facebook/callback
FB_OAUTH_STATE_SECRET=CHANGE_ME_TO_ANOTHER_STRONG_RANDOM_KEY
GOOGLE_CALLBACK_URL=https://api.nemarkchat.com/api/google-auth

# ───────── Nemark AI Cloud Gateway ─────────
AI_API_URL=https://api.nemarkchat.com/v1
AI_API_KEY=
AI_MODEL=gpt-5
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
NEMARK_AI_GATEWAY_TOKEN=

# ───────── System transactional email (encrypted admin settings, env fallback) ─────────
# Use SMTP_SECURE=true for implicit TLS (usually port 465).
# For port 587 keep SMTP_SECURE=false and SMTP_REQUIRE_TLS=true (STARTTLS).
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=NemarkChat
SMTP_CONNECTION_TIMEOUT_MS=8000
SMTP_COMMAND_TIMEOUT_MS=12000
SMTP_TLS_REJECT_UNAUTHORIZED=true

# ───────── Telegram admin notifications (server-only) ─────────
# Create a bot with @BotFather, then send it/group a message before running
# chat discovery through telegramNotifier.discoverChats().
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_TIMEOUT_MS=8000
TELEGRAM_NOTIFY_NEW_WORKSPACE=true
TELEGRAM_NOTIFY_PAYMENT=true
TELEGRAM_NOTIFY_SYSTEM_ERROR=true
TELEGRAM_ALERT_RATE_LIMIT_PER_MINUTE=12
TELEGRAM_ALERT_DEDUP_WINDOW_MS=300000

# ───────── Runtime dependency monitoring ─────────
HEALTH_MONITOR_ENABLED=true
HEALTH_MONITOR_AI_ENABLED=true
HEALTH_MONITOR_INTERVAL_MS=60000
HEALTH_MONITOR_INITIAL_DELAY_MS=15000
# Zalo Official Account connector readiness. Keep the secret server-side only.
ZALO_OA_APP_ID=
ZALO_OA_APP_SECRET=
ZALO_OA_CALLBACK_URL=https://api.nemarkchat.com/api/v1/zalo/oa/callback
